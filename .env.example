# --- infrastructure ---
REDIS_URL=redis://localhost:6379/0
DUCKDB_PATH=./data/payloop.db
RUN_ID=2026-08-31-final
API_PORT=8000
WEB_PORT=3000

# --- red agent ---
GEMINI_API_KEY=
RED_AGENT_MODEL=gemini-2.5-flash
RED_AGENT_MODE=offline
RED_AGENT_TIMEOUT_S=30.0

# --- population ---
POPULATION_SEED=42
SIM_DAYS=180
N_CARDHOLDERS=50000
N_MERCHANTS=4000
N_DEVICES=65000
N_IPS=12000
N_ACCOUNTS=50000
N_AGENTS=800
TARGET_EVENTS=2000000
DECLINE_MIX_REGION=GLOBAL

# --- prevalence ---
TARGET_FRAUD_RATE_CARD=0.0015
TARGET_FRAUD_RATE_UPI=0.0040
TARGET_FRAUD_RATE_RTP=0.0010
TARGET_FRAUD_RATE_AGENTIC=0.0050
PREVALENCE_HARD_CAP=0.01

# --- fidelity gate ---
FIDELITY_KS_MAX=0.10
FIDELITY_PCD_MAX=0.15
FIDELITY_BEHAVIORAL_MAX=10.0
FIDELITY_TSTR_MIN_RATIO=0.90
FIDELITY_DISCRIMINATOR_AUC_MAX=0.65
FIDELITY_MIA_AUC_MAX=0.55
MIA_MIN_ROWS=5000

# --- circularity breaker ---
LABEL_EMBARGO_DAYS=30
BLIND_HOLDOUT_VECTORS=V07
BLIND_HOLDOUT_ENTITY_FRAC=0.10

# --- loop ---
LOOP_ROUNDS=6
LOOP_PROPOSALS_PER_ROUND=6
LOOP_HARDEST_K=3

# --- detector ---
GNN_ENABLED=true
GNN_MIN_LIFT_PRAUC=0.03
LGBM_LEARNING_RATE=0.03
LGBM_NUM_LEAVES=63
LGBM_MIN_CHILD_SAMPLES=256
LGBM_EARLY_STOPPING_ROUNDS=32
IFOREST_CONTAMINATION=0.008

# --- cost matrix ---
COST_CHARGEBACK_FEE=25.0
COST_MERCHANT_MARGIN=0.22
COST_P_ATTRITION=0.32
COST_CUSTOMER_LTV=1800.0

# --- mitigation ladder ---
LADDER_APPROVE_MAX=0.30
LADDER_STEPUP_MAX=0.70
LADDER_HOLD_MAX=0.90

# --- latency harness ---
SCORING_LATENCY_BUDGET_MS=50.0
BENCH_ITERATIONS=10000
BENCH_WARMUP=500

# --- feature store ---
HLL_TTL_SECONDS=86400

# --- party scope ---
PARTY_ISSUER_ID=ISS_007
PARTY_ACQUIRER_ID=ACQ_014
